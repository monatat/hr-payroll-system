# Copy this file to .env and adjust if needed. Never commit the real .env.

# --- PostgreSQL / Backend datasource ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hr_payroll
DB_USERNAME=hr_payroll_app
DB_PASSWORD=changeme_local_only

# --- Backend server ---
SERVER_PORT=8080

# --- JWT authentication (Phase 4) ---
# Required for the backend to start. This is a placeholder ONLY -- it must
# never be used as a real secret. Generate your own long random value, e.g.
# `openssl rand -base64 48`. Must be at least 32 bytes (HS256 requirement).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_LOCAL_ONLY_SECRET_AT_LEAST_32_BYTES
# Access token lifetime in minutes. No refresh tokens in v1 -- expiry simply
# forces re-login. Default: 30.
JWT_EXPIRATION_MINUTES=30

# --- Bootstrap admin (Phase 4) ---
# Optional. If both are unset, no admin account is created and you'll need
# to seed one manually. This is a demo-appropriate provisioning mechanism
# only -- NOT a production secret-management solution. Never commit real
# credentials here.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- CORS (Phase 4) ---
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Payroll PDF storage (Phase 8C) ---
# Root directory for generated payslip PDFs. Relative paths resolve against
# the backend process's working directory. Never point this at src/main/resources.
PAYROLL_PDF_STORAGE_DIR=./data/payroll-pdfs

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
